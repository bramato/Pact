{
  "name": "@pact-protocol/core",
  "version": "0.2.0",
  "description": "Typed PACT Core and Swarm validation and A2A client",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../tools/build/sdk-resources.mjs && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-canonicalize": "3.0.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.4"
  }
}

{
  "name": "pact-conformance",
  "version": "0.2.0",
  "private": true,
  "description": "PACT specification, independent SDKs and live A2A conformance",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "sdk/typescript"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "build:sdk": "node tools/build/sdk-resources.mjs && npm run build --workspace @pact-protocol/core",
    "conformance": "node tools/conformance.mjs",
    "validate": "node tools/validate.mjs",
    "check": "npm test && npm run conformance && node tools/check-repository.mjs",
    "pretest": "npm run build:sdk"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}

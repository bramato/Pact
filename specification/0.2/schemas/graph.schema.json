{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bramato/Pact/blob/main/specification/0.2/schemas/graph.schema.json",
  "title": "PACT static Swarm plan v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "children",
    "aggregation_policy"
  ],
  "properties": {
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "child_id",
          "depends_on",
          "required",
          "weight"
        ],
        "properties": {
          "child_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": {
            "type": "boolean"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      }
    },
    "aggregation_policy": {
      "$ref": "https://github.com/bramato/Pact/blob/main/specification/0.2/schemas/aggregation-policy.schema.json"
    }
  }
}

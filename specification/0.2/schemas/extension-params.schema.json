{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bramato/Pact/blob/main/specification/0.2/schemas/extension-params.schema.json",
  "title": "PACT extension-params v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versions",
    "contracts",
    "features"
  ],
  "properties": {
    "versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "0.2.0"
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/bramato/Pact/blob/main/specification/0.2/schemas/contract.schema.json"
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "contracts",
          "questions",
          "events",
          "progress",
          "swarm"
        ]
      }
    }
  }
}

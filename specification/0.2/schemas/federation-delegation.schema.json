{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bramato/Pact/blob/main/specification/0.2/schemas/federation-delegation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_task_id",
    "parent_task_id",
    "delegation_id",
    "path",
    "steps",
    "delegations",
    "deadline",
    "task_id",
    "created_at"
  ],
  "properties": {
    "root_task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "delegations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pact/v1/schemas/swarm.schema.json",
  "title": "PACT swarm v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent_task_id",
    "coordinator_id",
    "children",
    "policy",
    "provenance",
    "parent_output_validated"
  ],
  "properties": {
    "parent_task_id": {
      "type": "string",
      "minLength": 1
    },
    "coordinator_id": {
      "type": "string",
      "minLength": 1
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.org/pact/v1/schemas/child.schema.json"
      }
    },
    "policy": {
      "$ref": "https://example.org/pact/v1/schemas/aggregation-policy.schema.json"
    },
    "provenance": {
      "$ref": "https://example.org/pact/v1/schemas/provenance.schema.json"
    },
    "parent_output_validated": {
      "type": "boolean"
    }
  }
}

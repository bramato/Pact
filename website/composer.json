{
    "name": "pact-protocol/website",
    "type": "project",
    "description": "The editorial introduction to PACT, without persistent services.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": { "php": "8.3.0" },
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
